<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="vi" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"></ttm:agent><ttm:title>Bởi Vì Em Tự Tin Em Là 'lông Lá'</ttm:title><amll:meta key="ttmlAuthorGithub" value="136059186" /><amll:meta key="ttmlAuthorGithubLogin" value="MiaowCham" /><amll:meta key="artists" value="Sói Ngủ Nướng" /><amll:meta key="album" value="Bởi Vì Em Tự Tin Em Là 'lông Lá'" /><amll:meta key="spotifyId" value="2c8p1kMuQUYa6LyMqHs8lj" /><amll:meta key="appleMusicId" value="6779507086" /><amll:meta key="isrc" value="QT6662602095" /><amll:meta key="ncmMusicId" value="3392989926" /><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Nguyễn Lê Minh Nguyên</songwriter></songwriters><transliterations><transliteration><text for="L1"><span begin="00:21.207" end="00:21.549">Mat </span><span begin="00:21.549" end="00:21.927">choi </span><span begin="00:21.927" end="00:22.287">chieu </span><span begin="00:22.287" end="00:22.647">tung </span><span begin="00:22.647" end="00:22.989">tia </span><span begin="00:22.989" end="00:23.349">any </span><span begin="00:23.349" end="00:23.749">shang</span></text><text for="L2"><span begin="00:24.111" end="00:24.439">Goi </span><span begin="00:24.439" end="00:24.809">Soi </span><span begin="00:24.809" end="00:25.180">thuk </span><span begin="00:25.180" end="00:25.519">zao </span><span begin="00:25.519" end="00:25.871">tu </span><span begin="00:25.871" end="00:26.209">zak </span><span begin="00:26.209" end="00:26.631">mo</span></text></transliteration></transliterations><translations><translation type="subtitle" xml:lang="zh-CN"><text for="L1">朝阳洒下缕缕光芒</text><text for="L2">唤醒了狼从梦乡</text><text for="L3">晨露在眼角轻轻荡漾</text><text for="L4">笑容永远挂在脸庞</text><text for="L5">抛开所有烦忧和惆怅</text><text for="L6">我的脚步轻盈悠扬</text><text for="L7">让晨光找到我的方向</text><text for="L8">灿烂闪耀 不再躲藏</text><text for="L9">让我的歌声在晨光中回荡！</text><text for="L10">呼唤黎明 放声欢唱</text><text for="L11">每一道条纹 每一处斑点 皆是我的模样</text><text for="L12">Yeah！我闪耀如初升的朝阳</text><text for="L13">让我的歌声在晨光中翱翔！</text><text for="L14">把人生谱成一首歌 满载光芒</text><text for="L15">这就是我！</text><text for="L16">利爪与心跳 合而为一响</text><text for="L17">自信的我 就在晨光中闪亮</text><text for="L18">雨后天空终会放晴</text><text for="L19">定会看见彩虹闪耀晶莹</text><text for="L20">当他们看着我 说“好奇怪”</text><text for="L21">我看见他们无法交换的色彩</text><text for="L22">不再细数那些“我不行”</text><text for="L23">我选择踏上那未知的路径</text><text for="L24">即便辛苦也值得庆幸</text><text for="L25">能与珍视的伙伴们同欢共庆</text><text for="L26">让我的歌声在晨光中回荡！</text><text for="L27">呼唤黎明 放声欢唱</text><text for="L28">每一道条纹 每一处斑点 皆是我的模样</text><text for="L29">Yeah！我闪耀如初升的朝阳</text><text for="L30">让我的歌声在晨光中翱翔！</text><text for="L31">把人生谱成一首歌 满载光芒</text><text for="L32">这就是我！</text><text for="L33">利爪与心跳 合而为一响</text><text for="L34">自信的我 就在晨光中闪亮</text><text for="L35">曾把兜帽压低 遮住脸庞</text><text for="L36">藏起素描本 藏起光芒</text><text for="L37">却挡不住我画满一页又一页的色彩飞扬</text><text for="L38">因为我就是我 自信的“毛毛怪”</text><text for="L39">让我永远天真烂漫 在晨光下笑颜常开</text><text for="L40">温柔拥抱伤痛 只为寻回那一场梦来</text><text for="L41">让我的歌声在晨光中回荡！</text><text for="L42">呼唤黎明 放声欢唱</text><text for="L43">每一道条纹 每一处斑点 皆是我的模样</text><text for="L44">Yeah！我闪耀如初升的朝阳</text><text for="L45">让我的歌声在晨光中翱翔！</text><text for="L46">把人生谱成一首歌 满载光芒</text><text for="L47">这就是我！</text><text for="L48">利爪与心跳 合而为一响</text><text for="L49">让我的歌声在晨光中回荡！</text><text for="L50">呼唤黎明 放声欢唱</text><text for="L51">每一道条纹 每一处斑点 皆是我的模样</text><text for="L52">Yeah！我闪耀如初升的朝阳</text><text for="L53">让我的歌声在晨光中翱翔！</text><text for="L54">把人生谱成一首歌 满载光芒</text><text for="L55">这就是我！</text><text for="L56">利爪与心跳 合而为一响</text><text for="L57">自信的我 就在晨光中闪亮</text></translation></translations></iTunesMetadata></metadata></head><body dur="03:44.092"><div begin="00:21.207" end="00:43.686" itunes:songPart="Verse"><p begin="00:21.207" end="00:23.749" ttm:age