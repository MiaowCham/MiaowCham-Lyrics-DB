                        </text>
                        <text for="L57">
                            <span begin="03:39.902" end="03:40.241" xmlns="http://www.w3.org/ns/ttml">Tu</span>
                            <span begin="03:40.241" end="03:40.950" xmlns="http://www.w3.org/ns/ttml">tin,</span>
                            <span begin="03:41.321" end="03:41.652" xmlns="http://www.w3.org/ns/ttml">ching</span>
                            <span begin="03:41.652" end="03:42.001" xmlns="http://www.w3.org/ns/ttml">em</span>
                            <span begin="03:42.001" end="03:42.172" xmlns="http://www.w3.org/ns/ttml">in</span>
                            <span begin="03:42.172" end="03:42.350" xmlns="http://www.w3.org/ns/ttml">the</span>
                            <span begin="03:42.350" end="03:42.851" xmlns="http://www.w3.org/ns/ttml">morning</span>
