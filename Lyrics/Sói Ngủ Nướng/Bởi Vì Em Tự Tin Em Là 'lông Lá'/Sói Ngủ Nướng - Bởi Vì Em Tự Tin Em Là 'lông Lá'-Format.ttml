                <span begin="00:29.727" end="00:30.087">nụ</span><space/>
                <span begin="00:30.087" end="00:30.239">cười</span><space/>
                <span begin="00:30.239" end="00:30.447">mãi</span><space/>
                <span begin="00:30.447" end="00:30.799">luôn</span><space/>
