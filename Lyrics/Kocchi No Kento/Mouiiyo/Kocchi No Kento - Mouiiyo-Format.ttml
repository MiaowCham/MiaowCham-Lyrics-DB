                            <span begin="02:40.845" end="02:41.287" xmlns="http://www.w3.org/ns/ttml">yai</span>
                            <span begin="02:41.287" end="02:41.670" xmlns="http://www.w3.org/ns/ttml">yai</span>
                            <span begin="02:41.670" end="02:42.074" xmlns="http://www.w3.org/ns/ttml">yai</span>
                            <span begin="02:42.074" end="02:42.464" xmlns="http://www.w3.org/ns/ttml">yai</span>
                        </text>
                        <text for="L54">
                            <span begin="02:42.464" end="02:43.327" xmlns="http://www.w3.org/ns/ttml">iitsuke</span>
                            <span begin="02:43.327" end="02:43.725" xmlns="http://www.w3.org/ns/ttml">chae</span>
                            <span begin="02:44.089" end="02:44.725" xmlns="http://www.w3.org/ns/ttml">konoyo</span>
                            <span begin="02:44.725" end="02:44.933" xmlns="http://www.w3.org/ns/ttml">o</span>
                            <span begin="02:44.933" end="02:45.349" xmlns="http://www.w3.org/ns/ttml">teki</span>
