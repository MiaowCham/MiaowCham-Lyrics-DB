                        </text>
                        <text for="L32">
                            <span begin="02:54.488" end="02:54.923" xmlns="http://www.w3.org/ns/ttml">dou</span>
                            <span begin="02:54.923" end="02:55.659" xmlns="http://www.w3.org/ns/ttml">agai</span>
                            <span begin="02:55.659" end="02:55.843" xmlns="http://www.w3.org/ns/ttml">te</span>
