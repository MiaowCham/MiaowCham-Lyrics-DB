                <span begin="00:07.290" end="00:07.959">常識</span>
                <span begin="00:07.959" end="00:08.682">だろ</span>
                <span begin="00:08.682" end="00:08.937">う</span>
            </p>
            <p begin="00:09.102" end="00:13.403" ttm:agent="v1" itunes:key="L3">
                <span begin="00:09.102" end="00:10.322">指先</span>
                <span begin="00:10.322" end="00:10.523">が</span>
                <span begin="00:10.523" end="00:11.336">震え</span>
                <span begin="00:11.336" end="00:11.974">よう</span>
                <span begin="00:11.974" end="00:13.403">とも</span>
            </p>
            <p begin="00:13.673" end="00:17.810" ttm:agent="v1" itunes:key="L4">
                <span begin="00:13.673" end="00:14.189">地図</span>
                <span begin="00:14.189" end="00:14.399">に</span>
                <span begin="00:14.399" end="00:14.601">は</span>
                <span begin="00:14.601" end="00:15.002">ない</span>
                <span begin="00:15.002" end="00:15.774">はず</span>
                <span begin="00:15.774" end="00:15.989">の</span>
                <span begin="00:15.989" end="00:17.234">三叉路</span>
                <span begin="00:17.234" end="00:17.395">に</span>
                <span begin="00:17.395" end="00:17.810">今</span>
            </p>
            <p begin="00:18.017" end="00:20.332" ttm:agent="v1" itunes:key="L5">
                <span begin="00:18.017" end="00:18.232">ぶつ</span>
                <span begin="00:18.232" end="00:18.444">かっ</span>
                <span begin="00:18.597" end="00:18.795">て</span>
                <span begin="00:18.795" end="00:19.065">いる</span>
                <span begin="00:19.065" end="00:19.276">の</span>
                <span begin="00:19.276" end="00:20.122">です</span>
                <span begin="00:20.122" end="00:20.332">が</span>
            </p>
            <p begin="00:20.417" end="00:26.916" ttm:agent="v1" itunes:key="L6">
                <span begin="00:20.417" end="00:21.068">何</span>
                <span begin="00:21.068" end="00:21.390">を</span>
                <span begin="00:21.478" end="00:22.294">頼</span>
                <span begin="00:22.294" end="00:22.528">り</span>
                <span begin="00:22.528" end="00:23.016">に</span>
                <span begin="00:23.016" end="00:23.843">進め</span>
                <span begin="00:23.843" end="00:24.075">ば</span>
                <span begin="00:24.075" end="00:24.961">いい</span>
                <span begin="00:24.961" end="00:25.249">の</span>
                <span begin="00:25.714" end="00:26.168">でしょ</span>
                <span begin="00:26.168" end="00:26.510">う</span>
                <span begin="00:26.510" end="00:26.916">か</span>
            </p>
            <p begin="00:27.321" end="00:30.355" ttm:agent="v1" itunes:key="L7">
                <span begin="00:27.321" end="00:27.861">教科書</span>
                <span begin="00:27.861" end="00:28.349">通り</span>
                <span begin="00:28.349" end="00:28.525">と</span>
                <span begin="00:28.525" end="00:28.733">は</span>
                <span begin="00:28.733" end="00:29.141">よく</span>
                <span begin="00:29.141" end="00:29.553">言った</span>
                <span begin="00:29.553" end="00:29.958">もの</span>
                <span begin="00:29.958" end="00:30.355">で</span>
            </p>
            <p begin="00:30.587" end="00:32.838" ttm:agent="v1" itunes:key="L8">
                <span begin="00:30.587" end="00:31.248">難しい</span>
                <span begin="00:31.248" end="00:31.917">言葉</span>
                <span begin="00:31.917" end="00:32.838">だらけ</span>
            </p>
            <p begin="00:33.006" end="00:38.562" ttm:agent="v1" itunes:key="L9">
                <span begin="00:33.006" end="00:33.747">今日</span>
                <span begin="00:33.747" end="00:34.344">あの</span>
                <span begin="00:34.435" end="00:35.273">頃</span>
                <span begin="00:35.273" end="00:36.052">から</span>
                <span begin="00:36.052" end="00:36.622">少し</span>
