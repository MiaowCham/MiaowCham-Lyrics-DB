2.355" end="01:52.509">de</span><span begin="01:52.509" end="01:53.506">ru</span></text><text for="L26"><span begin="02:05.479" end="02:05.631">you</span><span begin="02:05.631" end="02:05.885">ra</span><span begin="02:05.885" end="02:06.248">nai n</span><span begin="02:06.248" end="02:06.633">de</span><span begin="02:06.633" end="02:06.950">sho</span><span begin="02:07.085" end="02:07.450">shi</span><span begin="02:07.450" end="02:07.851">te</span><span begin="02:07.851" end="02:07.989">ru</span><span begin="02:07.989" end="02:08.245">yo</span><span begin="02:08.387" end="02:08.704">hiroshi</span><span begin="02:08.704" end="02:09.180">tsuu</span><span begin="02:09.180" end="02:09.433">ni</span><span begin="02:09.592" end="02:10.259">fu</span><span begin="02:10.259" end="02:10.395">ke</span><span begin="02:10.395" end="02:10.796">nai</span></text><text for="L27"><span begin="02:10.869" end="02:11.219">ba</span><span begin="02:11.219" end="02:11.539">ka</span><span begin="02:11.539" end="02:11.707">mi</span><span begin="02:11.707" end="02:11.974">tai</span><span begin="02:12.070" end="02:12.464">ba</span><span begin="02:12.464" end="02:12.795">ka</span><span begin="02:12.795" end="02:12.929">mi</span><span begin="02:12.929" end="02:13.233">tai</span><span begin="02:13.398" end="02:13.650">dou</span><span begin="02:13.650" end="02:14.024">ya</span><span begin="02:14.024" end="02:14.355">te</span><span begin="02:14.355" end="02:14.985">emi</span><span begin="02:14.985" end="02:15.516">u</span><span begin="02:15.609" end="02:16.563">no</span></text><text for="L28"><span begin="02:20.377" end="02:20.608">hate</span><span begin="02:20.608" end="02:20.862">te</span><span begin="02:20.862" end="02:21.190">shi</span><span begin="02:21.190" end="02:21.692">nai</span><span begin="02:21.692" end="02:21.866">wa</span><span begin="02:21.866" end="02:22.313">zu</span><span begin="02:22.313" end="02:22.920">da</span><span begin="02:22.920" end="02:23.070">ta</span><span begin="02:23.070" end="02:23.594">yume ga</span><span begin="02:23.594" end="02:24.009">kai</span><span begin="02:24.009" end="02:24.631">reru</span><span begin="02:24.631" end="02:25.124">oto</span><span begin="02:25.124" end="02:25.402">ga</span><span begin="02:25.402" end="02:25.580">shi</span><span begin="02:25.580" end="02:26.012">ta</span></text><text for="L29"><span begin="02:26.029" end="02:26.827">namida</span><span begin="02:26.827" end="02:27.335">mo</span><span begin="02:27.335" end="02:27.788">de nai</span><span begin="02:27.959" end="02:28.586">sorosoro</span><span begin="02:28.586" end="02:29.004">chan</span><span begin="02:29.004" end="02:29.135">to</span><span begin="02:29.135" end="02:29.501">iki</span><span begin="02:29.501" end="02:29.846">yo</span><span begin="02:29.846" end="02:30.347">ka</span></text><text for="L30"><span begin="02:30.428" end="02:30.860">geki</span><span begin="02:30.860" end="02:31.186">shiku</span><span begin="02:31.186" end="02:31.819">deki</span><span begin="02:31.819" end="02:32.301">re</span><span begin="02:32.301" end="02:32.450">te</span><span begin="02:32.450" end="02:32.914">ta</span><span begin="02:32.914" end="02:33.286">kara</span><span begin="02:33.286" end="02:33.583">ei</span><span begin="02:33.583" end="02:33.758">gi</span><span begin="02:33.758" end="02:34.361">hou</span><span begin="02:34.361" end="02:34.640">ga</span><span begin="02:34.640" end="02:35.297">wakan na</span><span begin="02:35.297" end="02:35.629">i</span></text><text for="L31"><span begin="02:35.747" end="02:36.174">dou shi</span><span begin="02:36.174" end="02:36.848">te ima</span><span begin="02:36.848" end="02:37.231">sa</span><span begin="02:37.231" end="02:37.508">ra</span><span begin="02:37.508" end="02:38.357">kanashi</span><span begin="02:38.357" end="02:38.677">i</span></text><text for="L32"><span begin="02:38.704" end="02:39.354">hontouha</span><span begin="02:39.354" end="02:39.785">dare ka</span><span begin="02:39.785" end="02:40.089">mi</span><span begin="02:40.089" end="02:40.462">tai</span><span begin="02:40.462" end="02:40.902">ni</span></text><text for="L33"><span begin="02:40.915" end="02:41.765">kou</span><span begin="02:41.765" end="02:42.298">se ni</span><span begin="02:42.298" end="02:42.439">na</span><span begin="02:42.439" end="02:43.120">rita</span><span begin="02:43.120" end="02:43.390">ka</span><span begin="02:43.390" end="02:43.784">ta</span></text></transliteration></transliterations><translations><translation type="subtitle" xml:lang="zh-CN"><text for="L1">若等待终无改变</text><text for="L2">谁都不能依靠</text><text for="L3">就算归咎于他人这痛苦也不会消失</text><text for="L4">想告别只有抱膝蜷缩的每一天</text><text for="L5">明明根本不信什么神明</text><text for="L6">烦死了 别管我</text><text for="L7">素不相识的人嘶哑歌唱说你不孤独</text><text for="L8">声嘶力竭地唱着</text><text for="L9">这样的言语或许也能拯救某些生命吧</text><text for="L10">不明白 是这样吗 有这回事吗 忘了</text><text for="L11">真麻烦 想毁掉 却又没有勇气</text><text for="L12">谁来告诉我活下去的理由 快点</text><text for="L13">替代品要多少有多少</text><text for="L14">做自己哪能说得那么简单</text><text for="L15">若能如愿就请夺回</text><text for="L16">那充满梦想的真相</text><text for="L17">喂 有人在吗</text><text for="L18">从何时起一成不变的景色让我厌倦至极</text><text for="L19">对不变的景色已经彻底厌烦</text><text for="L20">尽是棘手之事高耸眼前 终结了理想</text><text for="L21">渴望更肮脏直击心底的像人说的话</text><text for="L22">沉沦 无光之海连声音也无法回响</text><text for="L23">刚以为接通就断裂的</text><text for="L24">复杂丝线纠缠不清</text><text for="L25">逃避现实苟活维系生命</text><text for="L26">不需要吧 我知道 无法正常行走</text><text for="L27">像傻瓜 像傻瓜 要怎么笑呢</text><text for="L28">听见了本应无尽的梦破碎的声音</text><text for="L29">欲哭无泪 差不多该好好活了吧</text><text for="L30">因为深陷溺水所以不知如何游泳</text><text for="L31">事到如今为何悲伤</text><text for="L32">其实也曾想像某人一样</text><text for="L33">获得幸福</text></translation></translations></iTunesMetadata></metadata></head><body dur="02:43.784"><div begin="00:00.617" end="02:43.784"><p begin="00:00.617" end="00:03.667" ttm:agent="v1" itunes:key="L1"><span begin="00:00.617" end="00:01.077">いつまで</span><span begin="00:01.077" end="00:01.399">待っ</span><span begin="00:01.399" end="00:01.679">たっ</span><span begin="00:01.679" end="00:01.828">て</span><span begin="00:01.828" end="00:02.654">何ひとつ</span><span begin="00:02.654" end="00:03.504">変わらないんな</span><span begin="00:03.504" end="00:03.667">ら</span></p><p begin="00:03.681" end="00:05.860" ttm:agent="v1" itunes:key="L2"><span begin="00:03.681" end="00:04.942">どいつもコイツも</span><span begin="00:04.942" end="00:05.299">アテに</span><span begin="00:05.299" end="00:05.860">ならない</span></p><p begin="00:06.045" end="00:10.611" ttm:agent="v1" itunes:key="L3"><span begin="00:06.045" end="00:06.406">そ</span><span begin="00:06.406" end="00:06.891">もそも</span><span begin="00:06.891" end="00:07.443">誰かの</span><span begin="00:07.443" end="00:08.087">せいだと</span><span begin="00:08.087" end="00:08.379">言っ</span><span begin="00:08.379" end="00:08.710">たって</span><span begin="00:08.710" end="00:09.639">この痛みは</span><span begin="00:09.639" end="00:09.970">消え</span><span begin="00:09.970" end="00:10.251">ないん</span><span begin="00:10.251" end="00:10.611">だ</span></p><p begin="00:10.918" end="00:15.968" ttm:agent="v1" itunes:key="L4"><span begin="00:10.918" end="00:11.185">じっと</span><span begin="00:11.185" end="00:11.551">膝を</span><span begin="00:11.551" end="00:12.148">抱えて</span><span begin="00:12.148" end="00:12.969">うずくまる</span><span begin="00:12.969" end="00:13.441">だけの</span><span begin="00:13.606" end="00:14.324">毎日に</span><span begin="00:14.324" end="00:14.914">さよなら</span><span begin="00:14.914" end="00:15.377">したいと</span><span begin="00:15.377" end="00:15.659">願</span><span begin="00:15.659" end="00:15.968">う</span></p><p begin="00:16.052" end="00:20.285" ttm:agent="v1" itunes:key="L5"><span begin="00:16.052" end="00:16.473">神</span><span begin="00:16.473" end="00:16.882">様</span><span begin="00:16.882" end="00:17.301">なんて</span><span begin="00:17.301" end="00:17.797">これっ</span><span begin="00:17.797" end="00:18.029">ぽっ</span><span begin="00:18.029" end="00:18.410">ちも</span><span begin="00:18.545" end="00:19.129">信じて</span><span begin="00:19.129" end="00:19.761">ないくせ</span><span begin="00:19.761" end="00:20.285">に</span></p><p begin="00:20.484" end="00:28.335" ttm:agent="v1" itunes:key="L6"><span begin="00:20.484" end="00:20.788">うる</span><span begin="00:20.788" end="00:21.181">さ</span><span begin="00:21.181" end="00:21.706">いん</span><span begin="00:21.706" end="00:21.998">だ</span><span begin="00:21.998" end="00:23.888">よ </span><span begin="00:25.641" end="00:25.861">ほっ</span><span begin="00:25.861" end="00:26.189">とい</span><span begin="00:26.189" end="00:26.555">て</span><span begin="00:26.555" end="00:26.746">く</span><span begin="00:26.746" end="00:27.077">れ</span><span begin="00:27.077" end="00:28.335">よ</span></p><p begin="00:30.916" end="00:33.654" ttm:agent="v1" itunes:key="L7"><span begin="00:30.916" end="00:31.345">ひとり</span><span begin="00:31.345" end="00:31.894">なんかじゃ</span><span begin="00:31.894" end="00:32.404">ないよって</span><span begin="00:32.404" end="00:32.949">知らない</span><span begin="00:32.949" end="00:33.359">誰</span><span begin="00:33.359" end="00:33.524">か</span><span begin="00:33.524" end="00:33.654">が</span></p><p begin="00:33.669" end="00:35.868" ttm:agent="v1" itunes:key="L8"><span begin="00:33.669" end="00:34.785">声を嗄らして</span><span begin="00:34.785" end="00:35.310">歌っ</span><span begin="00:35.310" end="00:35.612">てい</span><span begin="00:35.612" end="00:35.868">る</span></p><p begin="00:36.031" end="00:40.251" ttm:agent="v1" itunes:key="L9"><span begin="00:36.031" end="00:36.500">そんな</span><span begin="00:36.500" end="00:37.156">言葉に</span><span begin="00:37.156" end="00:37.707">救わ</span><span begin="00:37.707" end="00:37.930">れ</span><span begin="00:37.930" end="00:38.298">る</span><span begin="00:38.298" end="00:38.886">命も</span><span begin="00:38.886" end="00:39.318">あるん</span><span begin="00:39.318" end="00:39.780">だろう</span><span begin="00:39.780" end="00:40.251">な</span></p><p begin="00:40.384" end="00:45.785" ttm:agent="v1" itunes:key="L10"><span begin="00:40.384" end="00:40.611">わ</span><span begin="00:40.611" end="00:41.177">から</span><span begin="00:41.177" end="00:41.726">な</span><span begin="00:41.726" end="00:42.042">い </span><span begin="00:42.073" end="00:42.430">そう</span><span begin="00:42.430" end="00:42.918">なん</span><span begin="00:42.918" end="00:43.229">だ </span><span begin="00:43.385" end="00:43.733">そう</span><span begin="00:43.733" end="00:44.151">だっ</span><span begin="00:44.151" end="00:44.433">け？ </span><span begin="00:44.525" end="00:45.244">忘</span><span begin="00:45.244" end="00:45.392">れ</span><span begin="00:45.392" end="00:45.785">た</span></p><p begin="00:45.884" end="00:50.359" ttm:agent="v1" itunes:key="L11"><span begin="00:45.884" end="00:46.130">面</span><span begin="00:46.130" end="00:46.543">倒</span><span begin="00:46.543" end="00:46.643">く</span><span begin="00:46.643" end="00:46.969">さい </span><span begin="00:47.114" end="00:47.752">壊</span><span begin="00:47.752" end="00:48.098">した</span><span begin="00:48.098" end="00:48.368">い </span><span begin="00:48.473" end="00:49.001">勇</span><span begin="00:49.001" end="00:49.596">気も</span><span begin="00:49.596" end="00:49.880">な</span><span begin="00:49.880" end="00:50.359">い</span></p><p begin="00:50.432" end="00:56.024" ttm:agent="v1" itunes:key="L12"><span begin="00:50.432" end="00:50.586">生</span><span begin="00:50.586" end="00:50.894">き</span><span begin="00:50.894" end="00:51.248">て</span><span begin="00:51.248" end="00:51.755">い</span><span begin="00:51.755" end="00:51.886">く</span><span begin="00:51.886" end="00:52.316">理</span><span begin="00:52.316" end="00:53.001">由っ</span><span begin="00:53.001" end="00:53.127">て</span><span begin="00:53.127" end="00:53.626">やつを</span><span begin="00:53.626" end="00:53.995">誰</span><span begin="00:53.995" end="00:54.419">か</span><span begin="00:54.419" end="00:54.907">教</span><span begin="00:54.907" end="00:55.153">え</span><span begin="00:55.153" end="00:55.374">て </span><span begin="00:55.374" end="00:55.505">は</span><span begin="00:55.505" end="00:56.024">やく</span></p><p begin="00:56.047" end="01:00.348" ttm:agent="v1" itunes:key="L13"><span begin="00:56.047" end="00:56.253">代</span><span begin="00:56.253" end="00:56.743">わ</span><span begin="00:56.743" end="00:56.885">り</span><span begin="00:56.885" end="00:57.367">なん</span><span begin="00:57.367" end="00:57.469">て</span><span begin="00:57.469" end="00:57.869">さ </span><span begin="00:57.983" end="00:58.682">いくらでも</span><span begin="00:58.682" end="00:59.190">転</span><span begin="00:59.190" end="00:59.443">がっ</span><span begin="00:59.443" end="00:59.826">てん</span><span begin="00:59.826" end="01:00.348">だ</span></p><p begin="01:00.391" end="01:05.623" ttm:agent="v1" itunes:key="L14"><span begin="01:00.391" end="01:00.919">自分</span><span begin="01:00.919" end="01:01.190">ら</span><span begin="01:01.190" end="01:01.702">し</span><span begin="01:01.702" end="01:01.856">く</span><span begin="01:01.856" end="01:02.163">な</span><span begin="01:02.163" end="01:02.436">んて</span><span begin="01:02.436" end="01:02.872">そ</span><span begin="01:02.872" end="01:03.121">んな</span><span begin="01:03.121" end="01:03.991">簡単に</span><span begin="01:03.991" end="01:04.312">言</span><span begin="01:04.312" end="01:04.692">わ</span><span begin="01:04.692" end="01:04.846">な</span><span begin="01:04.846" end="01:05.212">いで</span><span begin="01:05.212" end="01:05.623">しょ</span></p><p begin="01:05.710" end="01:08.658" ttm:agent="v1" itunes:key="L15"><span begin="01:05.710" end="01:06.179">叶う</span><span begin="01:06.179" end="01:06.838">のな</span><span begin="01:06.838" end="01:07.178">ら</span><span begin="01:07.178" end="01:07.689">取り</span><span begin="01:07.689" end="01:08.245">返</span><span begin="01:08.245" end="01:08.377">し</span><span begin="01:08.377" end="01:08.658">て</span></p><p begin="01:08.695" end="01:10.870" ttm:agent="v1" itunes:key="L16"><span begin="01:08.695" end="01:09.215">夢に</span><span begin="01:09.215" end="01:09.793">溢れて</span><sp