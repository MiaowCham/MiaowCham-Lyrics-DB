<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:title>Voiceless Fish (Shin Kawasaki (Temporary))</ttm:title><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Shogo Ohnishi</songwriter><songwriter>カイザー恵理菜</songwriter></songwriters><transliterations><transliteration><text for="L1"><span begin="00:00.617" end="00:01.077">itsu made</span><span begin="00:01.077" end="00:01.399">ma</span><span begin="00:01.399" end="00:01.679">ta</span><span begin="00:01.679" end="00:01.828">te</span><span begin="00:01.828" end="00:02.654">nani hitotsu</span><span begin="00:02.654" end="00:03.504">kawara nai n na</span><span begin="00:03.504" end="00:03.667">ra</span></text><text for="L2"><span begin="00:03.681" end="00:04.942">do itsumo koitsu mo</span><span begin="00:04.942" end="00:05.299">ate ni</span><span begin="00:05.299" end="00:05.860">nara nai</span></text><text for="L3"><span begin="00:06.045" end="00:06.406">so</span><span begin="00:06.406" end="00:06.891">moso mo</span><span begin="00:06.891" end="00:07.443">dare ka no</span><span begin="00:07.443" end="00:08.087">seida to</span><span begin="00:08.087" end="00:08.379">i</span><span begin="00:08.379" end="00:08.710">tatte</span><span begin="00:08.710" end="00:09.639">kono itami wa</span><span begin="00:09.639" end="00:09.970">kie</span><span begin="00:09.970" end="00:10.251">nai n</span><span begin="00:10.251" end="00:10.611">da</span></text><text for="L4"><span begin="00:10.918" end="00:11.185">jitto</span><span begin="00:11.185" end="00:11.551">hiza o</span><span begin="00:11.551" end="00:12.148">kakae te</span><span begin="00:12.148" end="00:12.969">uzukumaru</span><span begin="00:12.969" end="00:13.441">dake no</span><span begin="00:13.606" end="00:14