            <p begin="00:21.172" end="00:22.970" ttm:agent="v2" itunes:key="L9">
                <span begin="00:21.172" end="00:21.392">はい</span>
                <span begin="00:21.392" end="00:21.730">隊長 </span>
                <span begin="00:21.730" end="00:21.814">俺</span>
                <span begin="00:21.814" end="00:21.979">に</span>
                <span begin="00:21.979" end="00:22.155">名案</span>
                <span begin="00:22.155" end="00:22.470">が</span><space/>
                <span ttm:role="x-bg" ttm:agent="v1">
                    <span begin="00:22.379" end="00:22.695">(却下)</span>
                </span>
            </p>
            <p begin="00:22.614" end="00:24.199" ttm:agent="v2" itunes:key="L10">
                <span begin="00:22.614" end="00:22.733">って</span>
                <span begin="00:22.733" end="00:22.865">まだ</span>
                <span begin="00:22.865" end="00:23.014">なに</span>
