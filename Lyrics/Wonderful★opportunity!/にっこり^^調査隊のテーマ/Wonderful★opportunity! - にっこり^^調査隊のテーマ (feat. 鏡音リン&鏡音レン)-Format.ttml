            <p begin="00:19.363" end="00:21.622" ttm:agent="v1" itunes:key="L8">
                <span begin="00:19.363" end="00:19.718">我々</span>
                <span begin="00:19.718" end="00:19.862">は</span>
                <span begin="00:20.030" end="00:20.230">世界</span>
                <span begin="00:20.230" end="00:20.346">の</span>
