                            <itunes:span begin="03:15.783" end="03:16.044">o</itunes:span>
                            <itunes:span begin="03:16.044" end="03:16.495">kanae</itunes:span>
                            <itunes:span begin="03:16.495" end="03:17.082">teyaru</itunes:span>
                            <itunes:span begin="03:17.318" end="03:17.620">te</itunes:span>
                        </itunes:text>
                        <itunes:text for="L103">
                            <itunes:span begin="03:18.380" end="03:18.761">kono</itunes:span>
                            <itunes:span begin="03:18.761" end="03:19.521">nikkori</itunes:span>
                            <itunes:span begin="03:19.521" end="03:19.871">ni</itunes:span>
                            <itunes:span begin="03:19.871" end="03:20.551">fure</itunes:span>
                            <itunes:span begin="03:20.551" end="03:20.863">te</itunes:span>
                        </itunes:text>
                        <itunes:text for="L104">
                            <itunes:span begin="03:20.863" end="03:21.357">motto</itunes:span>
                            <itunes:span begin="03:21.357" end="03:21.680">mune</itunes:span>
                            <itunes:span begin="03:21.680" end="03:22.499">fukurami ma</itunes:span>
                            <itunes:span begin="03:22.499" end="03:22.726">shi</itunes:span>
                            <itunes:span begin="03:22.844" end="03:23.087">ta</itunes:span>
                            <itunes:span begin="03:23.211" end="03:23.375">to</itunes:span>
                            <itunes:span begin="03:23.375" end="03:23.730">sa</itunes:span>
