9.816" end="03:01.200">supaisuda tte</span></text><text for="L95"><span begin="03:01.382" end="03:02.206">kanpekida</span><span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg"><span begin="03:02.246" end="03:02.574">(nani</span><span begin="03:02.574" end="03:02.742">ga)</span></span></text><text for="L96"><span begin="03:02.266" end="03:02.994">nikkori</span><span begin="03:02.994" end="03:04.074">korikorikori</span><span begin="03:04.074" end="03:04.290">o</span><span begin="03:04.290" end="03:04.725">rikou</span><span begin="03:04.725" end="03:05.226">chan</span></text><text for="L97"><span begin="03:05.226" end="03:05.885">otona</span><span begin="03:05.885" end="03:06.037">mo</span><span begin="03:06.037" end="03:06.565">kodomo</span><span begin="03:06.565" end="03:06.706">mo</span></text><text for="L98"><span begin="03:06.706" end="03:07.405">netsuretsu</span><span begin="03:07.405" end="03:08.066">kangei</span></text><text for="L99"><span begin="03:08.174" end="03:08.506">mochi</span><span begin="03:08.506" end="03:09.238">wareware</span><span begin="03:09.238" end="03:09.534">mo</span><span begin="03:09.534" end="03:10.001">chousa</span><span begin="03:10.001" end="03:12.276">taishouda</span></text><text for="L100"><span begin="03:11.505" end="03:11.727">Run</span><span begin="03:11.727" end="03:12.347">away</span><span begin="03:12.347" end="03:12.706">wei</span><span begin="03:12.706" end="03:13.173">wei</span><span begin="03:13.173" end="03:13.519">u e i</span></text><text for="L101"><span begin="03:13.212" end="03:14.543">watashida tte</span><span begin="03:14.543" end="03:15.234">itsu</span><span begin="03:15.234" end="03:15.524">ka</span></text><text for="L102"><span begin="03:15.524" end="03:15.783">yume</span><span begin="03:15.783" end="03:16.044">o</span><span begin="03:16.044" end="03:16.495">kanae</span><span begin="03:16.495" end="03:17.082">teyaru</span><span begin="03:17.318" end="03:17.620">te</span></text><text for="L103"><span begin="03:18.380" end="03:18.761">kono</span><span begin="03:18.761" end="03:19.521">nikkori</span><span begin="03:19.521" end="03:19.871">ni</span><span begin="03:19.871" end="03:20.551">fure</span><span begin="03:20.551" end="03:20.863">te</span></text><text for="L104"><span begin="03:20.863" end="03:21.357">motto</span><span begin="03:21.357" end="03:21.680">mune</span><span begin="03:21.680" end="03:22.499">fukurami ma</span><span begin="03:22.499" end="03:22.726">shi</span><span begin="03:22.844" end="03:23.087">ta</span><span begin="03:23.211" end="03:23.375">to</span><span begin="03:23.375" end="03:23.730">sa</span></text></transliteration></transliterations><translations><translation type="subtitle" xml:lang="zh-CN"><text for="L1">微笑调查队</text><text for="L2">祝你早中晚整天都好 <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(how are you?)</span></text><text for="L3">今天也是最棒的一天啊</text><text for="L4">Oh~Wonderhoy！</text><text for="L5">探索！收集！探求！</text><text for="L7">各位！ <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(在！)</span></text><text for="L8">我们要去调查全世界的笑容啦！</text><text for="L9">好的队长 我有个名案 <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(驳回)</span></text><text for="L10">喂等等我可是还什么都没有说啊？</text><text for="L11">真是的 总—而—言—之 不是有句老话 说百蚊不如一见来着？</text><text for="L12">啊啊 说的是百闻不如一见吧</text><text for="L13">对对就是这个！</text><text for="L14">这意思是要捉虫子？（恐） <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(这意思是要捉虫子？（恐)</span></text><text for="L15">才不是啦</text><text for="L16">队长！</text><text for="L17">什么什么~ <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(干什么？)</span></text><text for="L18">我有个提案</text><text for="L19">这可务必说来让我们听听啊</text><text for="L20">总之就是</text><text for="L21">总之就是？</text><text for="L22">总之就先出发吧 计划什么的不需要 <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(嗯！)</span></text><text for="L23">给我等下 <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(诶？)</span></text><text for="L24">出发前进！</text><text for="L25">都说了等一下啦！至少行李给我准备好啊~！</text><text for="L26">几・天・后</text><text for="L27">那么现在 就开始检查行李啦——</text><text for="L28">首先是最基本的！</text><text for="L29">护！护护 护照带上了吧？ <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(带着！)</span></text><text for="L30">换！换换 换洗衣服被我忘啦！ <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(诶)</span></text><text for="L31">充！充电宝有记得带上了吧？ <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(带了~)</span></text><text for="L32">志！志气也随身带好了吧？</text><text for="L33">那是当然！</text><text for="L34">有伙伴在身边</text><text for="L35">有自己来当先</text><text for="L36">而且都不是平凡之辈</text><text for="L37">这是在说谁呢？</text><text for="L38">我们一定有什么能力可以将不可能变为可能</text><text for="L39">nicoricoricoricori coriander</text><text for="L40">这里那里客人都会</text><text for="L41">接踵而来！</text><text for="L42">你的笑容也由我来收下哦</text><text for="L43">yeah——yeah yeah yeah~</text><text for="L44">无所谓面前是大人还是小孩</text><text for="L45">这才是一流的</text><text for="L46">enter~↓tainment~↑</text><text for="L47">总有一天 我也一定</text><text for="L48">会让我的梦想实现 <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(我们做得到！)</span></text><text for="L49">被这满满笑容包围的我</text><text for="L50">也将会高高地挺起胸膛 <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(好！)</span></text><text for="L51">好的 全体看过来——</text><text for="L52">微笑调查队</text><text for="L53">基本上不费吹灰之力~</text><text for="L54">摆出调查的样子</text><text for="L55">趁现在！邪恶就用铁拳制裁！ <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(我来！)</span></text><text for="L56">调查报告之一</text><text for="L57">笑容是会传染的 <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(笨蛋也是会传染的)</span></text><text for="L58">不要啊~听起来好可怕</text><text for="L59">各位！ <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(怎么了？)</span></text><text for="L60">糟了糟了 收集的数据完全不够</text><text for="L61">总之就是</text><text for="L62">总之就是？</text><text for="L63">总之就是 奇妙之旅还得继续啊—— <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(是啊——)</span></text><text for="L64">这话轮不到你们说~！</text><text for="L65">几・天・后</text><text for="L66">那么现在 就开始检查行李啦——</text><text for="L67">那就还是老样子！</text><text for="L68">护！护护 护照带上了吧？ <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(带着！)</span></text><text for="L69">换！换换 换的裤子我又给忘啦！ <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(诶~)</span></text><text for="L70">充！充电宝有记得带上了吧？ <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(带了~)</span></text><text for="L71">志！志气也随身带好了吧？</text><text for="L72">那是当然！</text><text for="L73">哪怕异国来宾</text><text for="L74">无论男女老少</text><text for="L75">一切都无关紧要</text><text for="L76">我们可是驰骋世界哒</text><text for="L77">这边的世界也还绝对绝对不能舍弃哦</text><text for="L78">开玩笑的♪</text><text for="L79">nicoricoricoricori 聪明又伶俐</text><text for="L80">无论内向还是外向都</text><text for="L81">welcome welcome</text><text for="L82">你的笑容就是调查对象啊</text><text for="L83">yeah——yeah yeah yeah~</text><text for="L84">Physical Mental Total OK</text><text for="L85">效果拔群的</text><text for="L86">enter~↓tainment~↑</text><text for="L87">总有一天 我也一定</text><text for="L88">会让我的梦想实现 <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(我们做得到！)</span></text><text for="L89">被这满满笑容包围的我</text><text for="L90">也将会高高地挺起胸膛</text><text for="L91">将所有的失落都变成开心的笑容</text><text for="L92">尽管交给我们吧 make your smile <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(Fu~)</span></text><text for="L93">无论是高涨的时刻 还是低落的时刻</text><text for="L94">都作为调味料 混在一起尽情搅拌就好啦</text><text for="L95">简直完美 <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(你指啥？)</span></text><text for="L96">nicoricoricoricori 聪明又伶俐</text><text for="L97">大人小孩都</text><text for="L98">热烈欢迎！</text><text for="L99">我们自己当然也是调查对象哦！</text><text for="L100">Run away way way way~</text><text for="L101">总有一天 我也一定</text><text for="L102">会让我的梦想实现 <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(我们做得到！)</span></text><text for="L103">被这满满笑容包围的我</text><text for="L104">也将会高高地挺起胸膛</text></translation></translations></iTunesMetadata></metadata></head><body dur="03:24.230"><div begin="00:02.729" end="00:19.105" itunes:songPart="Intro"><p begin="00:02.729" end="00:04.497" ttm:agent="v1000" itunes:key="L1"><span begin="00:02.729" end="00:03.402">にっこり</span><span begin="00:03.402" end="00:03.725">調査</span><span begin="00:03.725" end="00:04.047">隊</span></p><p begin="00:04.047" end="00:05.274" ttm:agent="v1000" itunes:key="L2"><span begin="00:04.047" end="00:04.174">お</span><span begin="00:04.174" end="00:04.396">はこん</span><span begin="00:04.396" end="00:04.558">ばん</span><span begin="00:04.558" end="00:04.774">ちわ</span> <span ttm:role="x-bg"><span begin="00:04.774" end="00:04.900">(How </span><span begin="00:04.900" end="00:05.074">are </span><span begin="00:05.074" end="00:05.223">you?)</span></span></p><p begin="00:05.359" end="00:07.093" ttm:agent="v1000" itunes:key="L3"><span begin="00:05.359" end="00:05.527">今日</span><span begin="00:05.527" end="00:05.708">も</span><span begin="00:05.708" end="00:05.876">今日</span><span begin="00:05.876" end="00:06.031">とて </span><span begin="00:06.031" end="00:06.389">最高</span><span begin="00:06.389" end="00:06.593">です</span></p><p begin="00:06.743" end="00:08.563" ttm:agent="v1000" itunes:key="L4"><span begin="00:06.743" end="00:07.133">おぉ</span><span begin="00:07.133" end="00:07.402">~</span><span begin="00:07.402" end="00:07.745">わんだ</span><span begin="00:07.745" end="00:08.063">ほーい！</span></p><p begin="00:10.031" end="00:16.513" ttm:agent="v1000" itunes:key="L5"><span begin="00:10.031" end="00:10.709">探索！</span><span begin="00:12.528" end="00:13.373">コレクション！</span><span begin="00:15.341" end="00:16.013">探求！</span></p><p begin="00:17.339" end="00:19.105" ttm:agent="v1000" itunes:key="L6"><span begin="00:17.339" end="00:17.699">E・</span><span begin="00:17.699" end="00:17.874">G・</span><span begin="00:17.874" end="00:18.245">A・</span><span begin="00:18.245" end="00:18.605">O</span> <span ttm:role="x-roman">/ / /</span></p></div><div begin="00:18.718" end="00:41.827" itunes:songPart="Verse"><p begin="00:18.718" end="00:19.554" ttm:agent="v1" itunes:key="L7"><span begin="00:18.718" end="00:19.054">諸君！</span> <span ttm:role="x-bg"><span begin="00:19.051" end="00:19.219">(はい！)</span></span></p><p begin="00:19.363" end="00:21.622" ttm:agent="v1" itunes:key="L8"><span begin="00:19.363" end="00:19.718">我々</span><span begin="00:19.718" end="00:19.862">は</span><span begin="00:20.030" end="00:20.230">世界</span><span begin="00:20.230" end="00:20.346">の</span><span begin="00:20.346" end="00:20.522">笑顔</span><span begin="00:20.522" end="00:20.714">を</span><span begin="00:20.714" end="00:20.995">調査</span><span begin="00:20.995" end="00:21.194">する！</span></p><p begin="00:21.172" end="00:22.970" ttm:agent="v2" itunes:key="L9"><span begin="00:21.172" end="00:21.392">はい</span><span begin="00:21.392" end="00:21.730">隊長 </span><span begin="00:21.730" end="00:21.814">俺</span><span begin="00:21.814" end="00:21.979">に</span><span begin="00:21.979" end="00:22.155">名案</span><span begin="00:22.155" end="00:22.470">が</span> <span ttm:role="x-bg" ttm:agent="v1"><span begin="00:22.379" end="00:22.695">(却下)</span></span></p><p begin="00:22.614" end="00:24.199" ttm:agent="v2" itunes:key="L10"><span begin="00:22.614" end="00:22.733">って</span><span begin="00:22.733" end="00:22.865">まだ</span><span begin="00:22.865" end="00:23.014">なに</span><span begin="00:23.014" end="00:23.207">も</span><span begin="00:23.207" end="00:23.370">いって</span><span begin="00:23.370" end="00:23.710">ないんだ</span><span begin="00:23.710" end="00:23.857">が？</span></p><p begin="00:23.749" end="00:26.705" ttm:agent="v1" itunes:key="L11"><span begin="00:23.749" end="00:23.962">もー </span><span begin="00:24.076" end="00:24.238">とー</span><span begin="00:24.238" end="00:24.341">にー</span><span begin="00:24.341" end="00:24.537">かー</span><span begin="00:24.537" end="00:24.701">く </span><span begin="00:24.701" end="00:24.989">あれだ</span><span begin="00:24.989" end="00:25.258">ほら </span><span begin="00:25.341" end="00:25.717">カナブン</span><span begin="00:25.717" end="00:25.808">は</span><span begin="00:25.808" end="00:26.084">一見</span><span be