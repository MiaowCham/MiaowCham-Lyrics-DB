    <body dur="01:57.982">
        <div begin="00:07.443" end="01:57.982">
            <p begin="00:07.443" end="00:10.624" ttm:agent="v1" itunes:key="L1">
                <span begin="00:07.443" end="00:07.835">用法</span>
                <span begin="00:07.835" end="00:08.234">容量</span>
                <span begin="00:08.234" end="00:08.983">度外視</span>
                <span begin="00:08.983" end="00:09.403">合法 </span>
                <span begin="00:09.403" end="00:09.854">doping </span>
                <span begin="00:09.854" end="00:10.195">time</span><space/>
                <span ttm:role="x-bg">
                    <span begin="00:10.353" end="00:10.624">(Time)</span>
                </span>
            </p>
            <p begin="00:10.971" end="00:14.321" ttm:agent="v1" itunes:key="L2">
                <span begin="00:10.971" end="00:11.401">死体</span>
                <span begin="00:11.401" end="00:12.102">のようで</span>
                <span begin="00:12.102" end="00:12.542">脳は </span>
                <span begin="00:12.542" end="00:13.001">Happy </span>
                <span begin="00:13.001" end="00:13.469">Happy </span>
                <span begin="00:13.469" end="00:13.891">Happy </span>
                <span begin="00:13.891" end="00:14.321">Dance</span>
            </p>
            <p begin="00:14.545" end="00:18.665" ttm:agent="v1" itunes:key="L3">
                <span begin="00:14.545" end="00:14.915">「ちょっと</span>
                <span begin="00:14.915" end="00:15.305">だけ</span>
                <span begin="00:15.305" end="00:16.065">休憩」で</span>
                <span begin="00:16.065" end="00:16.522">終われ</span>
                <span begin="00:16.522" end="00:16.955">たら</span>
                <span begin="00:16.955" end="00:17.395">訳</span>
                <span begin="00:17.395" end="00:18.665">ないわ</span>
            </p>
            <p begin="00:21.877" end="00:25.180" ttm:agent="v1" itunes:key="L4">
                <span ttm:role="x-bg">
                    <span begin="00:21.877" end="00:22.813">(Warning? </span>
                    <span begin="00:22.813" end="00:23.015">Don't </span>
                    <span begin="00:23.015" end="00:24.415">worry)</span>
                </span><space/>
                <span begin="00:23.861" end="00:24.278">溺</span>
                <span begin="00:24.278" end="00:25.180">れて</span>
            </p>
            <p begin="00:25.381" end="00:28.784" ttm:agent="v1" itunes:key="L5">
                <span ttm:role="x-bg">
                    <span begin="00:25.381" end="00:26.322">(Warning? </span>
                    <span begin="00:26.322" end="00:26.562">Don't </span>
                    <span begin="00:26.562" end="00:27.722">worry)</span>
                </span><space/>
                <span begin="00:27.370" end="00:27.850">流</span>
                <span begin="00:27.850" end="00:28.784">されて</span>
            </p>
            <p begin="00:29.049" end="00:33.974" ttm:agent="v1" itunes:key="L6">
                <span ttm:role="x-bg">
                    <span begin="00:29.049" end="00:29.900">(Warning? </span>
                    <span begin="00:29.900" end="00:30.129">Don't </span>
                    <span begin="00:30.129" end="00:31.140">worry)</span>
                </span><space/>
