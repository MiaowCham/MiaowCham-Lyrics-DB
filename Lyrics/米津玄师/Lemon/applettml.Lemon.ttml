59.722">ga</span><span begin="02:59.722" end="03:01.188">deki</span><span begin="03:01.188" end="03:02.577">nai</span></text><text for="L31"><span begin="03:02.708" end="03:03.274">anna</span><span begin="03:03.274" end="03:03.875">ni</span><span begin="03:03.875" end="03:05.303">soba</span><span begin="03:05.303" end="03:05.706">ni</span><span begin="03:05.706" end="03:06.673">ita</span><span begin="03:06.673" end="03:08.120">noni</span></text><text for="L32"><span begin="03:08.782" end="03:10.064">maru</span><span begin="03:10.064" end="03:10.732">de</span><span begin="03:10.732" end="03:12.163">uso</span><span begin="03:12.163" end="03:13.679">mitai</span></text><text for="L33"><span begin="03:13.931" end="03:14.281">tote</span><span begin="03:14.281" end="03:14.981">mo</span><span begin="03:14.981" end="03:16.313">wasure</span><span begin="03:16.313" end="03:17.680">rare</span><span begin="03:17.680" end="03:19.367">nai</span></text><text for="L34"><span begin="03:19.708" end="03:22.544">sore dake</span><span begin="03:22.544" end="03:23.243">ga</span><span begin="03:23.243" end="03:24.645">tashi</span><span begin="03:24.645" end="03:25.700">ka</span></text><text for="L35"><span begin="03:30.089" end="03:30.855">ano hi no</span><span begin="03:30.855" end="03:31.523">kana</span><span begin="03:31.523" end="03:32.190">shimi</span><span begin="03:32.190" end="03:32.858">sae</span><span begin="03:32.858" end="03:33.589">ano hi no</span><span begin="03:33.589" end="03:34.257">kuru</span><span begin="03:34.257" end="03:34.925">shimi</span><span begin="03:34.925" end="03:35.597">sae</span></text><text for="L36"><span begin="03:35.607" end="03:36.039">sono</span><span begin="03:36.039" end="03:36.591">subete</span><span begin="03:36.591" end="03:37.041">o</span><span begin="03:37.041" end="03:37.607">ai</span><span begin="03:37.607" end="03:37.946">shite</span><span begin="03:37.946" end="03:38.408">ta</span><span begin="03:38.408" end="03:39.339">anata</span><span begin="03:39.339" end="03:39.746">to</span><span begin="03:39.746" end="03:40.546">tomo</span><span begin="03:40.546" end="03:41.146">ni</span></text><text for="L37"><span begin="03:41.246" end="03:41.623">mune ni</span><span begin="03:41.623" end="03:42.558">nokori</span><span begin="03:42.558" end="03:43.556">hanare</span><span begin="03:43.556" end="03:44.157">nai</span><span begin="03:44.157" end="03:44.624">nigai</span><span begin="03:44.624" end="03:45.556">remon no</span><span begin="03:45.556" end="03:46.720">nioi</span></text><text for="L38"><span begin="03:47.057" end="03:47.756">ame ga</span><span begin="03:47.756" end="03:48.421">furi</span><span begin="03:48.421" end="03:49.089">yamu</span><span begin="03:49.089" end="03:50.023">made wa</span><span begin="03:50.023" end="03:51.089">kaere</span><span begin="03:51.089" end="03:52.249">nai</span></text><text for="L39"><span begin="03:52.550" end="03:52.883">kiri</span><span begin="03:52.883" end="03:53.917">waketa</span><span begin="03:53.917" end="03:55.185">kajitsu no</span><span begin="03:55.185" end="03:56.584">katahou no</span><span begin="03:56.584" end="03:57.747">you ni</span></text><text for="L40"><span begin="03:58.054" end="03:58.454">ima</span><span begin="03:58.454" end="03:59.119">demo</span><span begin="03:59.119" end="04:00.152">anata</span><span begin="04:00.152" end="04:00.454">wa</span><span begin="04:00.454" end="04:01.187">wata</span><span begin="04:01.187" end="04:01.854">shi no</span><span begin="04:01.854" end="04:04.277">hikari</span></text></transliteration></transliterations><translations><translation type="subtitle" xml:lang="zh-CN"><text for="L1">如果这是一场梦该多好</text><text for="L2">我仍然梦见你</text><text for="L3">就像回家拿你忘记的东西</text><text for="L4">拂去旧记忆的尘埃</text><text for="L5">总有一种幸福是回不来的</text><text for="L6">最后你告诉我</text><text for="L7">我隐藏起来却无法谈论的黑暗过去</text><text for="L8">没有你我将永远处于黑暗的地方</text><text for="L9">我确信我不会再受伤</text><text for="L10">我知道这不会发生</text><text for="L11">哪怕那天的悲伤 哪怕那天的痛苦</text><text for="L12">我喜欢和你在一起的一切</text><text for="L13">苦涩的柠檬味留在我心里</text><text for="L14">雨停之前我不能回家</text><text for="L15">你依然是我的光</text><text for="L16">我在黑暗中追踪你的背影</text><text for="L17">我清楚地记得它的轮廓</text><text for="L18">每次遇到无法接受的事情</text><text for="L19">唯一止不住的就是泪水</text><text for="L20">你在做什么你在看什么</text><text for="L21">拥有我不知道的个人资料</text><text for="L22">在某个地方你现在就像我一样</text><text for="L23">如果你流泪感到孤独</text><text for="L24">请忘记我</text><text for="L25">我越是真诚地希望</text><text for="L26">你依然是我的光</text><text for="L27">比我想象的</text><text for="L28">致曾经相爱的你</text><text for="L29">正如我从那时起所想的那样</text><text for="L30">我无法呼吸</text><text for="L31">即使我就这样在你身边</text><text for="L32">这就像一个谎言</text><text for="L33">如此难忘</text><text for="L34">这就是一切确定的事</text><text for="L35">哪怕那天的悲伤 哪怕那天的痛苦</text><text for="L36">我喜欢和你在一起的一切</text><text for="L37">苦涩的柠檬味留在我心里</text><text for="L38">雨停之前我不能回家</text><text for="L39">就像切开的水果的一半</text><text for="L40">你依然是我的光</text></translation></translations></iTunesMetadata></metadata></head><body dur="04:04.277"><div begin="00:00.801" end="00:58.378" itunes:songPart="Verse"><p begin="00:00.801" end="00:05.993" ttm:agent="v1" itunes:key="L1"><span begin="00:00.801" end="00:01.195">夢</span><span begin="00:01.195" end="00:01.712">なら</span><span begin="00:01.712" end="00:02.211">ば</span><span begin="00:02.211" end="00:02.912">どれ</span><span begin="00:02.912" end="00:03.563">ほど</span><span begin="00:03.563" end="00:03.912">よ</span><span begin="00:03.912" end="00:04.480">かった</span><span begin="00:04.480" end="00:04.928">で</span><span begin="00:04.928" end="00:05.993">しょう</span></p><p begin="00:06.341" end="00:11.534" ttm:agent="v1" itunes:key="L2"><span begin="00:06.341" end="00:07.365">未だ</span><span begin="00:07.365" end="00:07.680">に</span><span begin="00:07.680" end="00:08.074">あな</span><span begin="00:08.074" end="00:08.698">た</span><span begin="00:08.698" end="00:09.064">の</span><span begin="00:09.064" end="00:09.397">こと</span><span begin="00:09.397" end="00:09.914">を</span>