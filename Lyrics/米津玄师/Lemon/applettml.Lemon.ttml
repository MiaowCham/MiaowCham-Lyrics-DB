<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">Vocal 1</ttm:name></ttm:agent><amll:meta key="ttmlAuthorGithub" value="136059186" /><amll:meta key="ttmlAuthorGithubLogin" value="MiaowCham" /><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>米津玄師</songwriter></songwriters><transliterations><transliteration><text for="L1"><span begin="00:00.801" end="00:01.195">yume</span><span begin="00:01.195" end="00:01.712">nara</span><span begin="00:01.712" end="00:02.211">ba</span><span begin="00:02.211" end="00:02.912">dore</span><span begin="00:02.912" end="00:03.563">hodo</span><span begin="00:03.563" end="00:03.912">yo</span><span begin="00:03.912" end="00:04.480">katta</span><span begin="00:04.480" end="00:04.928">de</span><span begin="00:04.928" end="00:05.993">shou</span></text><text for="L2"><span begin="00:06.341" end="00:07.365">imada</span><span begin="00:07.365" end="00:07.680">ni</span><span begin="00:07.680" end="00:08.074">ana</span><span begin="00:08.074" end="00:08.698">ta</span><span begin="00:08.698" end="00:09.064">no</span><span begin="00:09.064" end="00:09.397">koto</span><span begin="00:09.397" end="00:09.914">o</span><span begin="00:09.914" end="00:10.677">yume ni</span><span begin="00:10.677" end="00:10.855">mi</span><span begin="00:10.855" end="00:11.534">ru</span></text><text for="L3"><span begin="00:11.855" end="00:12.778">wasureta</span><span begin="00:12.778" end="00:13.944">mono o</span><span begin="00:13.944" end="00:14.946">tori ni</span><span begin="00:14.946" end="00:15.979">kaeru</span><span begin="00:15.979" end="00:16.314">you</span><span begin="00:16.314" end="00:17.020">ni</span></text><text for="L4"><span be