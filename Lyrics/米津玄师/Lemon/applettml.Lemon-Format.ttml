                            <span begin="03:51.089" end="03:52.249" xmlns="http://www.w3.org/ns/ttml">nai</span>
                        </text>
                        <text for="L39">
                            <span begin="03:52.550" end="03:52.883" xmlns="http://www.w3.org/ns/ttml">kiri</span>
                            <span begin="03:52.883" end="03:53.917" xmlns="http://www.w3.org/ns/ttml">waketa</span>
                            <span begin="03:53.917" end="03:55.185" xmlns="http://www.w3.org/ns/ttml">kajitsu no</span>
                            <span begin="03:55.185" end="03:56.584" xmlns="http://www.w3.org/ns/ttml">katahou no</span>
                            <span begin="03:56.584" end="03:57.747" xmlns="http://www.w3.org/ns/ttml">you ni</span>
                        </text>
                        <text for="L40">
                            <span begin="03:58.054" end="03:58.454" xmlns="http://www.w3.org/ns/ttml">ima</span>
                            <span begin="03:58.454" end="03:59.119" xmlns="http://www.w3.org/ns/ttml">demo</span>
                            <span begin="03:59.119" end="04:00.152" xmlns="http://www.w3.org/ns/ttml">anata</span>
                            <span begin="04:00.152" end="04:00.454" xmlns="http://www.w3.org/ns/ttml">wa</span>
                            <span begin="04:00.454" end="04:01.187" xmlns="http://www.w3.org/ns/ttml">wata</span>
                            <span begin="04:01.187" end="04:01.854" xmlns="http://www.w3.org/ns/ttml">shi no</span>
                            <span begin="04:01.854" end="04:04.277" xmlns="http://www.w3.org/ns/ttml">hikari</span>
                        </text>
                    </transliteration>
                </transliterations>
                <translations>
                    <translation type="subtitle" xml:lang="zh-CN">
                        <text for="L1">如果这是一场梦该多好</text>
                        <text for="L2">我仍然梦见你</text>
                        <text for="L3">就像回家拿你忘记的东西</text>
                        <text for="L4">拂去旧记忆的尘埃</text>
                        <text for="L5">总有一种幸福是回不来的</text>
                        <text for="L6">最后你告诉我</text>
                        <text for="L7">我隐藏起来却无法谈论的黑暗过去</text>
                        <text for="L8">没有你我将永远处于黑暗的地方</text>
                        <text for="L9">我确信我不会再受伤</text>
                        <text for="L10">我知道这不会发生</text>
                        <text for="L11">哪怕那天的悲伤 哪怕那天的痛苦</text>
                        <text for="L12">我喜欢和你在一起的一切</text>
                        <text for="L13">苦涩的柠檬味留在我心里</text>
                        <text for="L14">雨停之前我不能回家</text>
                        <text for="L15">你依然是我的光</text>
                        <text for="L16">我在黑暗中追踪你的背影</text>
                        <text for="L17">我清楚地记得它的轮廓</text>
                        <text for="L18">每次遇到无法接受的事情</text>
                        <text for="L19">唯一止不住的就是泪水</text>
                        <text for="L20">你在做什么你在看什么</text>
                        <text for="L21">拥有我不知道的个人资料</text>
                        <text for="L22">在某个地方你现在就像我一样</text>
                        <text for="L23">如果你流泪感到孤独</text>
                        <text for="L24">请忘记我</text>
                        <text for="L25">我越是真诚地希望</text>
                        <text for="L26">你依然是我的光</text>
                        <text for="L27">比我想象的</text>
                        <text for="L28">致曾经相爱的你</text>
                        <text for="L29">正如我从那时起所想的那样</text>
                        <text for="L30">我无法呼吸</text>
                        <text for="L31">即使我就这样在你身边</text>
                        <text for="L32">这就像一个谎言</text>
                        <text for="L33">如此难忘</text>
                        <text for="L34">这就是一切确定的事</text>
                        <text for="L35">哪怕那天的悲伤 哪怕那天的痛苦</text>
                        <text for="L36">我喜欢和你在一起的一切</text>
                        <text for="L37">苦涩的柠檬味留在我心里</text>
                        <text for="L38">雨停之前我不能回家</text>
                        <text for="L39">就像切开的水果的一半</text>
                        <text for="L40">你依然是我的光</text>
                    </translation>
                </translations>
            </iTunesMetadata>
        </metadata>
    </head>
    <body dur="04:04.277">
        <div begin="00:00.801" end="00:58.378" itunes:songPart="Verse">
            <p begin="00:00.801" end="00:05.993" ttm:agent="v1" itunes:key="L1">
                <span begin="00:00.801" end="00:01.195">夢</span>
                <span begin="00:01.195" end="00:01.712">なら</span>
                <span begin="00:01.712" end="00:02.211">ば</span>
                <span begin="00:02.211" end="00:02.912">どれ</span>
                <span begin="00:02.912" end="00:03.563">ほど</span>
                <span begin="00:03.563" end="00:03.912">よ</span>
                <span begin="00:03.912" end="00:04.480">かった</span>
                <span begin="00:04.480" end="00:04.928">で</span>
                <span begin="00:04.928" end="00:05.993">しょう</span>
            </p>
            <p begin="00:06.341" end="00:11.534" ttm:agent="v1" itunes:key="L2">
                <span begin="00:06.341" end="00:07.365">未だ</span>
                <span begin="00:07.365" end="00:07.680">に</span>
                <span begin="00:07.680" end="00:08.074">あな</span>
                <span begin="00:08.074" end="00:08.698">た</span>
                <span begin="00:08.698" end="00:09.064">の</span>
                <span begin="00:09.064" end="00:09.397">こと</span>
                <span begin="00:09.397" end="00:09.914">を</span>
                <span begin="00:09.914" end="00:10.677">夢に</span>
                <span begin="00:10.677" end="00:10.855">み</span>
                <span begin="00:10.855" end="00:11.534">る</span>
            </p>
            <p begin="00:11.855" end="00:17.020" ttm:agent="v1" itunes:key="L3">
                <span begin="00:11.855" end="00:12.778">忘れた</span>
                <span begin="00:12.778" end="00:13.944">物を</span>
                <span begin="00:13.944" end="00:14.946">取りに</span>
                <span begin="00:14.946" end="00:15.979">帰る</span>
                <span begin="00:15.979" end="00:16.314">よう</span>
                <span begin="00:16.314" end="00:17.020">に</span>
            </p>
            <p begin="00:17.280" end="00:22.778" ttm:agent="v1" itunes:key="L4">
                <span begin="00:17.280" end="00:18.679">古びた</span>
                <span begin="00:18.679" end="00:19.712">思い出</span>
                <span begin="00:19.712" end="00:20.078">の</span>
                <span begin="00:20.078" end="00:21.645">埃を</span>
                <span begin="00:21.645" end="00:22.778">払う</span>
            </p>
            <p begin="00:25.701" end="00:30.828" ttm:agent="v1" itunes:key="L5">
                <span begin="00:25.701" end="00:26.408">戻ら</span>
                <span begin="00:26.408" end="00:27.044">ない</span>
                <span begin="00:27.044" end="00:28.345">幸せ</span>
                <span begin="00:28.345" end="00:28.713">が</span>
                <span begin="00:28.713" end="00:29.247">ある</span>
                <span begin="00:29.247" end="00:30.063">こと</span>
                <span begin="00:30.063" end="00:30.828">を</span>
            </p>
            <p begin="00:31.150" end="00:36.382" ttm:agent="v1" itunes:key="L6">
                <span begin="00:31.150" end="00:31.535">最</span>
                <span begin="00:31.535" end="00:32.203">後</span>
                <span begin="00:32.203" end="00:32.502">に</span>
                <span begin="00:32.502" end="00:32.902">あな</span>
                <span begin="00:32.902" end="00:33.570">た</span>
                <span begin="00:33.570" end="00:33.901">が</span>
                <span begin="00:33.901" end="00:34.269">教</span>
                <span begin="00:34.269" end="00:34.969">え</span>
                <span begin="00:34.969" end="00:35.268">て</span>
                <span begin="00:35.268" end="00:35.668">くれ</span>
                <span begin="00:35.668" end="00:36.382">た</span>
            </p>
            <p begin="00:36.703" end="00:41.879" ttm:agent="v1" itunes:key="L7">
                <span begin="00:36.703" end="00:37.072">言え</span>
                <span begin="00:37.072" end="00:37.405">ず</span>
                <span begin="00:37.405" end="00:37.664">に</span>
                <span begin="00:37.664" end="00:38.436">隠</span>
                <span begin="00:38.436" end="00:38.970">して</span>
                <span begin="00:38.970" end="00:39.469">た</span>
                <span begin="00:39.469" end="00:40.270">昏い</span>
                <span begin="00:40.270" end="00:41.138">過去</span>
                <span begin="00:41.138" end="00:41.879">も</span>
            </p>
            <p begin="00:42.202" end="00:47.461" ttm:agent="v1" itunes:key="L8">
                <span begin="00:42.202" end="00:42.557">あな</span>
                <span begin="00:42.557" end="00:43.551">たが</span>
                <span begin="00:43.551" end="00:44.332">いなきゃ</span>
                <span begin="00:44.332" end="00:45.249">永遠に</span>
                <span begin="00:45.249" end="00:46.709">昏いま</span>
                <span begin="00:46.709" end="00:47.461">ま</span>
            </p>
            <p begin="00:48.052" end="00:53.309" ttm:agent="v1" itunes:key="L9">
                <span begin="00:48.052" end="00:48.786">きっと</span>
                <span begin="00:48.786" end="00:49.120">もう</span>
                <span begin="00:49.120" end="00:49.518">これ</span>
                <span begin="00:49.518" end="00:50.818">以上 </span>
                <span begin="00:50.818" end="00:51.482">傷</span>
                <span begin="00:51.482" end="00:51.886">つく</span>
                <span begin="00:51.886" end="00:52.554">こと</span>
                <span begin="00:52.554" end="00:53.309">など</span>
            </p>
            <p begin="00:53.609" end="00:58.378" ttm:agent="v1" itunes:key="L10">
                <span begin="00:53.609" end="00:54.601">ありは</span>
                <span begin="00:54.601" end="00:54.961">しな</span>
                <span begin="00:54.961" end="00:56.000">いと</span>
                <span begin="00:56.000" end="00:57.301">わかって</span>
                <span begin="00:57.301" end="00:58.378">いる</span>
