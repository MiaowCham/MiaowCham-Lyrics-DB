                </transliterations>
                <translations>
                    <translation type="subtitle" xml:lang="zh-CN">
                        <text for="L1">太阳 
                            <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(远方寒风)</span>
                        </text>
                        <text for="L2">渐渐倾斜 
                            <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(天空缓缓泛白)</span>
                        </text>
                        <text for="L3">石之隅 
                            <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(循罗盘星指引)</span>
                        </text>
                        <text for="L4">投下暗影 
                            <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(寻你的路变得明亮)</span>
                        </text>
                        <text for="L5">远雷响彻</text>
                        <text for="L6">将孤独唤回</text>
                        <text for="L7">手中余尘</text>
                        <text for="L8">被寂静饮尽</text>
                        <text for="L9">为了知悉孤独</text>
                        <text for="L10">可曾将谁寻求</text>
                        <text for="L11">怎样的结局才能宽恕</text>
                        <text for="L12">干涸足迹上</text>
                        <text for="L13">水滴坠落</text>
                        <text for="L14">你的爱</text>
                        <text for="L15">释放至宇宙</text>
                        <text for="L16">收集记忆</text>
                        <text for="L17">巡游细胞间</text>
                        <text for="L18">于指尖盛放花朵</text>
                        <text for="L19">那是确凿无疑</text>
                        <text for="L20">生命灯火</text>
                        <text for="L21">曾踩碎的</text>
                        <text for="L22">红果之中</text>
                        <text for="L23">翩然 飞蛾展翅</text>
                        <text for="L24">太阳偷走我的影 
                            <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(夜深沉)</span>
                        </text>
                        <text for="L25">以低语将我捕捉 
                            <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(雨声之森)</span>
                        </text>
                        <text for="L26">漂于时间之河 
                            <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(烽烟之痕)</span>
                        </text>
                        <text for="L27">每场离别都使我们成长 
                            <span xmlns="http://www.w3.org/ns/ttml" ttm:role="x-bg">(掌中星)</span>
                        </text>
                        <text for="L28">就去追寻</text>
                        <text for="L29">生命之圆</text>
                        <text for="L30">去寻找我们在光中的所在</text>
                        <text for="L31">直到一天我们合而为一</text>
                        <text for="L32">你的爱</text>
                        <text for="L33">释放至宇宙</text>
                        <text for="L34">收集记忆</text>
                        <text for="L35">巡游细胞间</text>
                        <text for="L36">于指尖盛放花朵</text>
                        <text for="L37">那是确凿无疑</text>
                        <text for="L38">生命灯火</text>
                        <text for="L39">曾踩碎的</text>
                        <text for="L40">红果之中</text>
                        <text for="L41">翩然 飞蛾展翅</text>
                        <text for="L42">黑暗吞噬黎明</text>
                        <text for="L43">侵蚀光芒曾照耀</text>
                        <text for="L44">的边缘</text>
                        <text for="L45">灯塔始终漂泊</text>
                        <text for="L46">独自照亮什么秘密</text>
                        <text for="L47">黑暗吞噬黎明</text>
                        <text for="L48">侵蚀光芒曾照耀</text>
                        <text for="L49">的边缘</text>
                        <text for="L50">灯塔始终漂泊</text>
                        <text for="L51">独自照亮什么秘密</text>
                    </translation>
                </translations>
            </iTunesMetadata>
        </metadata>
    </head>
    <body dur="04:56.438">
        <div begin="00:10.148" end="04:56.438">
            <p begin="00:10.148" end="00:15.280" ttm:agent="v1" itunes:key="L1">
                <span begin="00:10.148" end="00:10.868">太</span>
                <span begin="00:10.868" end="00:11.527">陽</span>
                <span begin="00:11.527" end="00:12.597">が   </span><space/>
                <span ttm:role="x-bg">
                    <span begin="00:11.679" end="00:12.081">(Cold </span>
                    <span begin="00:12.081" end="00:12.998">winds </span>
                    <span begin="00:12.998" end="00:13.993">from </span>
                    <span begin="00:14.200" end="00:14.370">a</span>
                    <span begin="00:14.370" end="00:15.280">far)</span>
                </span>
            </p>
            <p begin="00:15.730" end="00:20.880" ttm:agent="v1" itunes:key="L2">
                <span begin="00:15.730" end="00:17.140">傾い</span>
                <span begin="00:17.140" end="00:18.550">て   </span><space/>
                <span ttm:role="x-bg">
                    <span begin="00:16.881" end="00:17.439">(The sky </span>
                    <span begin="00:17.439" end="00:18.536">slowly </span>
                    <span begin="00:18.536" end="00:19.888">grows </span>
                    <span begin="00:19.888" end="00:20.880">white)</span>
                </span>
            </p>
            <p begin="00:21.028" end="00:26.398" ttm:agent="v1" itunes:key="L3">
                <span begin="00:21.028" end="00:21.838">石の</span>
                <span begin="00:21.838" end="00:22.560">隅</span>
                <span begin="00:22.560" end="00:23.796">に   </span><space/>
                <span ttm:role="x-bg">
                    <span begin="00:22.618" end="00:23.121">(Guided </span>
                    <span begin="00:23.121" end="00:23.795">by </span>
                    <span begin="00:23.795" end="00:24.102">the </span>
                    <span begin="00:24.102" end="00:25.341">compass </span>
                    <span begin="00:25.341" end="00:26.398">star)</span>
                </span>
            </p>
            <p begin="00:26.531" end="00:32.179" ttm:agent="v1" itunes:key="L4">
                <span begin="00:26.531" end="00:27.471">影を</span>
                <span begin="00:27.471" end="00:28.182">落と</span>
                <span begin="00:28.182" end="00:29.351">す   </span><space/>
                <span ttm:role="x-bg">
                    <span begin="00:27.980" end="00:28.642">(My path </span>
                    <span begin="00:28.642" end="00:29.592">to you </span>
                    <span begin="00:29.592" end="00:30.946">turns </span>
                    <span begin="00:30.946" end="00:32.179">bright)</span>
                </span>
            </p>
            <p begin="00:33.535" end="00:36.186" ttm:agent="v1" itunes:key="L5">
                <span begin="00:33.535" end="00:34.198">遠く</span>
                <span begin="00:34.198" end="00:34.898">雷</span>
                <span begin="00:34.898" end="00:35.544">鳴</span>
                <span begin="00:35.544" end="00:36.186">が</span>
            </p>
            <p begin="00:36.299" end="00:39.050" ttm:agent="v1" itunes:key="L6">
                <span begin="00:36.299" end="00:36.886">孤独</span>
                <span begin="00:36.886" end="00:37.399">を</span>
                <span begin="00:37.399" end="00:37.855">呼び</span>
                <span begin="00:37.855" end="00:38.604">戻</span>
                <span begin="00:38.604" end="00:39.050">す</span>
            </p>
            <p begin="00:39.258" end="00:41.683" ttm:agent="v1" itunes:key="L7">
                <span begin="00:39.258" end="00:39.693">手に</span>
                <span begin="00:39.693" end="00:40.425">残</span>
                <span begin="00:40.425" end="00:40.625">る</span>
                <span begin="00:40.625" end="00:41.124">塵</span>
                <span begin="00:41.124" end="00:41.683">を</span>
            </p>
            <p begin="00:41.826" end="00:44.332" ttm:agent="v1" itunes:key="L8">
                <span begin="00:41.826" end="00:42.287">静</span>
                <span begin="00:42.287" end="00:42.990">寂</span>
                <span begin="00:42.990" end="00:43.185">が</span>
                <span begin="00:43.185" end="00:43.831">飲み干</span>
                <span begin="00:43.831" end="00:44.332">す</span>
            </p>
            <p begin="00:44.332" end="00:46.181" ttm:agent="v1" itunes:key="L9">
                <span begin="00:44.332" end="00:45.078">ひとりを</span>
                <span begin="00:45.078" end="00:46.181">知るため</span>
            </p>
            <p begin="00:46.181" end="00:49.517" ttm:agent="v1" itunes:key="L10">
                <span begin="00:46.181" end="00:46.790">誰か</span>
                <span begin="00:46.921" end="00:47.374">を</span>
                <span begin="00:47.374" end="00:48.918">求めていたの</span>
                <span begin="00:48.918" end="00:49.517">か</span>
            </p>
            <p begin="00:49.655" end="00:55.887" ttm:agent="v1" itunes:key="L11">
                <span begin="00:49.655" end="00:50.278">どんな</span>
                <span begin="00:50.278" end="00:51.634">結</span>
                <span begin="00:51.634" end="00:52.486">末</span>
                <span begin="00:52.722" end="00:53.099">な</span>
                <span begin="00:53.099" end="00:53.700">ら</span>
                <span begin="00:53.700" end="00:54.385">許</span>
                <span begin="00:54.385" end="00:54.994">せ</span>
                <span begin="00:54.994" end="00:55.887">る</span>
            </p>
            <p begin="00:55.887" end="00:58.599" ttm:agent="v2" itunes:key="L12">
                <span begin="00:55.887" end="00:57.184">乾いた足</span>
                <span begin="00:57.184" end="00:58.499">跡</span>
                <span begin="00:58.499" end="00:58.599">に</span>
            </p>
            <p begin="00:58.599" end="01:01.214" ttm:agent="v2" itunes:key="L13">
                <span begin="00:58.599" end="01:00.101">雫が落ち</span>
                <span begin="01:00.101" end="01:01.214">る</span>
            </p>
            <p begin="01:02.241" end="01:08.122" ttm:agent="v1" itunes:key="L14">
                <span begin="01:02.241" end="01:03.483">君</span>
                <span begin="01:03.483" end="01:04.197">の</span>
                <span begin="01:04.197" end="01:07.212">愛</span>
                <span begin="01:07.212" end="01:08.122">が</span>
            </p>
            <p begin="01:08.265" end="01:12.531" ttm:agent="v1" itunes:key="L15">
                <span begin="01:08.265" end="01:09.466">宇宙に</span>
                <span begin="01:09.466" end="01:10.981">放</span>
                <span begin="01:10.981" end="01:11.260">た</span>
                <span begin="01:11.260" end="01:12.531">れ</span>
            </p>
            <p begin="01:13.929" end="01:16.403" ttm:agent="v1" itunes:key="L16">
                <span begin="01:13.929" end="01:15.342">記憶を集</span>
                <span begin="01:15.342" end="01:16.403">めて</span>
            </p>
            <p begin="01:16.641" end="01:19.191" ttm:agent="v1" itunes:key="L17">
                <span begin="01:16.641" end="01:17.862">細胞を</span>
                <span begin="01:17.862" end="01:18.623">巡</span>
                <span begin="01:18.623" end="01:19.191">り</span>
            </p>
            <p begin="01:19.305" end="01:24.766" ttm:agent="v1" itunes:key="L18">
                <span begin="01:19.305" end="01:19.975">指</span>
                <span begin="01:19.975" end="01:20.927">先に</span>
                <span begin="01:20.927" end="01:22.866">花を</span>
