                        <text for="L51">
                            <span begin="04:51.046" end="04:51.367" xmlns="http://www.w3.org/ns/ttml">What</span>
                            <span begin="04:51.367" end="04:52.751" xmlns="http://www.w3.org/ns/ttml">secrets</span>
                            <span begin="04:52.751" end="04:53.413" xmlns="http://www.w3.org/ns/ttml">does it</span>
