                            <span begin="04:47.124" end="04:48.299" xmlns="http://www.w3.org/ns/ttml">ever</span>
                            <span begin="04:48.299" end="04:48.846" xmlns="http://www.w3.org/ns/ttml">on</span>
                            <span begin="04:48.846" end="04:49.298" xmlns="http://www.w3.org/ns/ttml">the</span>
