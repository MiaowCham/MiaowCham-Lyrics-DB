        <metadata><ttm:agent type="person" xml:id="v1" /><ttm:agent type="other" xml:id="v2" /><amll:meta key="musicName" value="拂晓" /><amll:meta key="musicName" value="Dawnbreak" /><amll:meta key="musicName" value="拂晓 Dawnbreak" /><amll:meta key="artists" value="HOYO-MiX" /><amll:meta key="artists" value="NIDA" /><amll:meta key="album" value="拂晓" /><amll:meta key="ttmlAuthorGithub" value="136059186" /><amll:meta key="ttmlAuthorGithubLogin" value="MiaowCham" />
            <itunes:iTunesMetadata>
                <itunes:translations>
                    <itunes:translation xml:lang="zh-CN">
                        <itunes:text for="L1">传奇并非天成</itunes:text>
                        <itunes:text for="L2">但由功迹铸就</itunes:text>
                        <itunes:text for="L3">所谓血脉 无足轻重</itunes:text>
                        <itunes:text for="L4">巨木何以擢于微种？</itunes:text>
                        <itunes:text for="L5">丰碑何以立于余烬？</itunes:text>
                        <itunes:text for="L6">历经失却 饮痛沥血</itunes:text>
                        <itunes:text for="L7">天穹尚晦仍应相搏</itunes:text>
                        <itunes:text for="L8">纵使此身脆弱只如苇草</itunes:text>
                        <itunes:text for="L9">然为逐火焚身已成信条</itunes:text>
                        <itunes:text for="L10">辟夜求光</itunes:text>
                        <itunes:text for="L11">斫断镣铐</itunes:text>
                        <itunes:text for="L12">所谓破晓生来自由</itunes:text>
                        <itunes:text for="L13">岁月磨蚀生命</itunes:text>
                        <itunes:text for="L14">往事亦如烟消</itunes:text>
                        <itunes:text for="L15">唯有信仰 流传回荡</itunes:text>
                        <itunes:text for="L16">凝神回望先辈英魄</itunes:text>
                        <itunes:text for="L17">昏晦之中竭力闪灼</itunes:text>
                        <itunes:text for="L18">鳞伤遍体 牺牲塞途</itunes:text>
                        <itunes:text for="L19">天穹尚晦 仍应相搏</itunes:text>
                        <itunes:text for="L20">纵使缺瑕伴身 绝不卑屈</itunes:text>
                        <itunes:text for="L21">宁为逐火焚身 亦不跪降</itunes:text>
                        <itunes:text for="L22">辟夜求光</itunes:text>
                        <itunes:text for="L23">斫断镣铐</itunes:text>
                        <itunes:text for="L24">所谓破晓 生来自由</itunes:text>
                        <itunes:text for="L25">你我同契 共搏九霄云穹</itunes:text>
                        <itunes:text for="L26">你我同契 誓将逆风执炬</itunes:text>
                        <itunes:text for="L27">你我同契 共搏九霄云穹</itunes:text>
                        <itunes:text for="L29">纵使此身脆弱 只如苇草</itunes:text>
                        <itunes:text for="L31">然为逐火焚身 已成信条</itunes:text>
                        <itunes:text for="L33">辟夜求光</itunes:text>
                        <itunes:text for="L34">咫尺侵晨</itunes:text>
                        <itunes:text for="L35">所谓破晓 终将自由</itunes:text>
                    </itunes:translation>
                </itunes:translations>
            </itunes:iTunesMetadata>
