<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"></ttm:agent><ttm:title>Beyond This Station</ttm:title><amll:meta key="ttmlAuthorGithubLogin" value="MiaowCham" /><amll:meta key="ttmlAuthorLyricify" value="MiaowCham" /><amll:meta key="ncmMusicId" value="3409349905" /><amll:meta key="artists" value="HOYO-MiX" /><amll:meta key="appleMusicId" value="6790171993" /><amll:meta key="album" value="Honkai: Star Rail - Let There Be Laughter (Part 2) [Original Game Soundtrack]" /><amll:meta key="isrc" value="FRX282673018" /><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>林一凡</songwriter><songwriter>Ruby Qu</songwriter><songwriter>黑金雨</songwriter><songwriter>王可鑫</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-CN"><text for="L1">铺设坐标</text><text for="L2">哦 哦</text><text for="L3">拓宽航道</text><text for="L4">哦 哦</text><text for="L5">我们将跨越星海</text><text for="L6">那无限延伸而出的</text><text for="L7">哦</text><text for="L8">是星轨 还是彼此联结的共鸣</text><text for="L9">哦</text><text for="L10">在这片静寂废墟中穿行</text><text for="L11">跨过漫天星尘后 你呢喃道</text><text for="L12">终有一日 我们会摆脱引力的束缚</text><text for="L13">直视前方 引擎启动 我们将在此开拓前路</text><text for="L14">哦 哦</text><text for="L15">在此立誓 我将再无迷惘</text><text for="L16">那些呼唤我的声音 我绝不会辜负</text><text for="L17">纵使前路既定 我们仍将面对</text><text for="L18">哦</text><text for="L19">无人愿屈从于命运终局</text><text for="L20">哦</text><text for="L21">抗争于此刻 沿着昔日的足迹</text><text for="L22">寻回那些散落深空的意志</text><text for="L23">全速进发</text><text for="L24">将誓言铭刻于心</text><text for="L25">不遗落任何一人</text><text for="L26">既然前路未定</text><text for="L27">就让我们铺就星轨</text><text for="L28">哦 哦</text><text for="L29">在此立誓 我将再无迷惘</text><text for="L30">那些呼唤我的声音 我绝不会辜负</text><text for="L31">以苏醒的悸动 我将撼动静默</text><text for="L32">从每处绝境中 夺回我们的曙光</text><text for="L33">我绝不逃避 也绝不再放手</text><text for="L34">逆空而上 穿越这渐毁的世界</text><text for="L35">燃尽此身 重塑星辰的航迹</text><text for="L36">直至时光尽头 撕碎这片死寂</text><text for="L37">坐标已确定</text><text for="L38">哦 哦</text><text for="L39">就让你我一同 撼动这个宙域</text><text for="L40">击穿那片天宇</text><text for="L41">直至那片群星的尽头</text></translation></translations></iTunesMetadata></metadata></head><body dur="03:43.104"><div begin="00:09.831" end="03:43.104"><p begin="00:09.831" end="00:10.954" ttm:agent="v1" itunes:key="L1"><span begin="00:09.831" end="00:10.237">Let's </span><span begin="00:10.237" end="00:10.457">pave </span><span begin="00:10.457" end="00:10.667">it </span><span begin="00:10.667" end="00:10.954">out</span></p><p begin="00:10.925" end="00:20.020" ttm:agent="v1" itunes:key="L2"><span begin="00:10.925" end="00:15.565">Oh, </span><span begin="00:16.051" end="00:20.020">oh</span></p><p begin="00:20.139" end="00:21.262" ttm:agent="v1" itunes:key="L3"><span begin="00:20.139" end="00:20.527">Let's </span><span begin="00:20.527" end="00:20.775">pave </span><span begin="00:20.775" end="00:20.913">it </span><span begin="00:20.913" end="00:21.262">out</span></p><p begin="00:21.235" end="00:30.365" ttm:agent="v1" itunes:key="L4"><span begin="00:21.235" end="00:25.881">Oh, </span><span begin="00:26.348" end="00:30.365">oh</span></p><p begin="00:30.470" end="00:31.593" ttm:agent="v1" itunes:key="L5"><span begin="00:30.470" end="00:30.841">Let's </span><span begin="00:30.841" end="00:31.147">pave </span><span begin="00:31.147" end="00:31.306">it </span><span begin="00:31.306" end="00:31.593">out</span></p><p begin="00:44.345" end="00:50.318" ttm:agent="v1" itunes:key="L6"><span begin="00:44.345" end="00:46.315">What's </span><span begin="00:46.315" end="00:46.929">stre</span><span begin="00:46.929" end="00:47.618">tching </span><span begin="00:47.618" end="00:48.270">so </span><span begin="00:48.270" end="00:49.111">far </span><span begin="00:49.111" en