
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata">
    <head>
        <metadata><ttm:agent type="person" xml:id="v1" /><ttm:agent type="other" xml:id="v2" />
            <itunes:iTunesMetadata>
                <itunes:translations>
                    <itunes:translation xml:lang="zh-CN">
                        <itunes:text for="L1">你以为我没忧愁</itunes:text>
                        <itunes:text for="L2">唱小曲儿喝小酒</itunes:text>
                        <itunes:text for="L3">虽然确实没搞错</itunes:text>
                        <itunes:text for="L4">但有时</itunes:text>
                        <itunes:text for="L5">我也难过</itunes:text>
                        <itunes:text for="L6">不想工作！</itunes:text>
                        <itunes:text for="L7">虽然赢过</itunes:text>
                        <itunes:text for="L8">无数战争</itunes:text>
                        <itunes:text for="L9">我也受折磨！</itunes:text>
                        <itunes:text for="L10">这之后</itunes:text>
                        <itunes:text for="L11">我明白了</itunes:text>
                        <itunes:text for="L12">压力太大，需要休假</itunes:text>
                        <itunes:text for="L13">和世界说再见走啦，么么哒</itunes:text>
                        <itunes:text for="L14">送上你</itunes:text>
                        <itunes:text for="L15">最好的问候:</itunes:text>
                        <itunes:text for="L16">么么哒</itunes:text>
                        <itunes:text for="L17">就说“放松一点”轻松一点</itunes:text>
                        <itunes:text for="L18">么么哒！</itunes:text>
                        <itunes:text for="L19">放过这些烦恼都会少些</itunes:text>
                        <itunes:text for="L20">么么哒！</itunes:text>
                        <itunes:text for="L21">看看这人</itunes:text>
                        <itunes:text for="L22">逃避工作不负责任</itunes:text>
                        <itunes:text for="L23">你也是</itunes:text>
                        <itunes:text for="L24">哈？</itunes:text>
                        <itunes:text for="L25">你还让人偶领导稻妻呢</itunes:text>
                        <itunes:text for="L26">身为领袖</itunes:text>
                        <itunes:text for="L27">不该不管属地</itunes:text>
                        <itunes:text for="L28">你不也是</itunes:text>
                        <itunes:text for="L29">嗯…</itunes:text>
                        <itunes:text for="L30">放假去</itunes:text>
                        <itunes:text for="L31">尘世闲游</itunes:text>
                        <itunes:text for="L32">不想工作！</itunes:text>
                        <itunes:text for="L33">虽然我们</itunes:text>
                        <itunes:text for="L34">赢过无数战争才存活</itunes:text>
                        <itunes:text for="L35">都过去了</itunes:text>
                        <itunes:text for="L36">我们选择</itunes:text>
                        <itunes:text for="L37">哦，你也是哦，纳西妲</itunes:text>
                        <itunes:text for="L38">你把记忆都丢了</itunes:text>
                        <itunes:text for="L39">你才是我们几个里面最硬核的！</itunes:text>
                        <itunes:text for="L40">呃…谢谢？</itunes:text>
                        <itunes:text for="L41">压力很大，需要休假</itunes:text>
                        <itunes:text for="L42">把烦恼抛到天空岛！</itunes:text>
                        <itunes:text for="L43">么么哒！</itunes:text>
                        <itunes:text for="L44">努力过</itunes:text>
                        <itunes:text for="L45">对考验你的人说，么么哒</itunes:text>
                        <itunes:text for="L46">是，你有珍爱的人</itunes:text>
                        <itunes:text for="L47">但在关键时刻</itunes:text>
                        <itunes:text for="L48">你也需要自由的生活！</itunes:text>
                        <itunes:text for="L49">没有什么损伤</itunes:text>
                        <itunes:text for="L50">不要自我上膛</itunes:text>
                        <itunes:text for="L51">除非你的人偶开杀戮模式了</itunes:text>
                        <itunes:text for="L52">云昏昏沉沉</itunes:text>
                        <itunes:text for="L53">仿佛正逼近</itunes:text>
                        <itunes:text for="L54">不要等待</itunes:text>
                        <itunes:text for="L55">愁云散尽</itunes:text>
                        <itunes:text for="L56">让你的心情飞到天际高~</itunes:text>
                        <itunes:text for="L57">飞到平流层…</itunes:text>
                        <itunes:text for="L58">压力太大，需要休假</itunes:text>
                        <itunes:text for="L59">别像特瓦林一样沉重，么么哒</itunes:text>
                        <itunes:text for="L60">郁闷了</itunes:text>
                        <itunes:text for="L61">别等到呼叫 S.O.S.</itunes:text>
                        <itunes:text for="L62">就说“放松一点”轻松一点——</itunes:text>
                        <itunes:text for="L63">么么哒！</itunes:text>
                        <itunes:text for="L64">放过这些烦恼都会少些</itunes:text>
                        <itunes:text for="L65">么么哒！</itunes:text>
                        <itunes:text for="L66">就说“放松一点”轻松一点——</itunes:text>
                        <itunes:text for="L67">么么哒！</itunes:text>
                        <itunes:text for="L68">放过这些烦恼都会少些</itunes:text>
                        <itunes:text for="L69">么么哒！</itunes:text>
                    </itunes:translation>
                </itunes:translations>
            </itunes:iTunesMetadata>
        </metadata>
    </head>
