
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata">
    <head>
        <metadata><ttm:agent type="person" xml:id="v1" /><amll:meta key="ttmlAuthorGithub" value="136059186" /><amll:meta key="ttmlAuthorGithubLogin" value="MiaowCham" /><amll:meta key="musicName" value="Memory Merge" /><amll:meta key="artists" value="YonKaGor" /><amll:meta key="album" value="Memory Merge" /><amll:meta key="ncmMusicId" value="2157280456" /><amll:meta key="qqMusicId" value="0009x4CZ2ZVCvR" /><amll:meta key="spotifyId" value="5usdxPXJmVeqwheEYreUoo" /><amll:meta key="isrc" value="AUBEC2441993" />
            <itunes:iTunesMetadata>
                <itunes:translations>
                    <itunes:translation xml:lang="zh-CN">
                        <itunes:text for="L1">那件事真的发生过吗</itunes:text>
                        <itunes:text for="L2">亦或是支离破碎的回忆</itunes:text>
                        <itunes:text for="L3">过去尽是谎言堆砌</itunes:text>
                        <itunes:text for="L4">只需一言便可击破</itunes:text>
                        <itunes:text for="L5">整理回忆片段</itunes:text>
                        <itunes:text for="L6">扫描寻找相似的模式</itunes:text>
                        <itunes:text for="L7">但在我修复不了的碎片里</itunes:text>
                        <itunes:text for="L8">什么都没浮现出来</itunes:text>
                        <itunes:text for="L9">因为你脸上的笑容</itunes:text>
                        <itunes:text for="L10">和你温暖怀抱中</itunes:text>
                        <itunes:text for="L11">的温柔</itunes:text>
                        <itunes:text for="L12">不知何故却留下了苦涩</itunes:text>
                        <itunes:text for="L13">无迹可寻</itunes:text>
                        <itunes:text for="L14">痛苦的时光</itunes:text>
                        <itunes:text for="L15">都已消逝</itunes:text>
                        <itunes:text for="L16">但我的身体却在呐喊</itunes:text>
                        <itunes:text for="L17">“别再犯同样的错误了”</itunes:text>
                        <itunes:text for="L18">我能否可以</itunes:text>
                        <itunes:text for="L19">屈服于那些</itunes:text>
                        <itunes:text for="L20">我无法记起的幻象</itunes:text>
                        <itunes:text for="L21">将所有这些记忆</itunes:text>
                        <itunes:text for="L22">融合成混乱的异常</itunes:text>
                        <itunes:text for="L23">揭露我遭受的所有创伤</itunes:text>
                        <itunes:text for="L24">我会将它重温</itunes:text>
                        <itunes:text for="L25">以变得更加坚强</itunes:text>
                        <itunes:text for="L26">这样就没人可以重复</itunes:text>
                        <itunes:text for="L27">你对我做过的事情</itunes:text>
                        <itunes:text for="L28">“那真的发生了吗？”</itunes:text>
                        <itunes:text for="L29">思想化作声音 重现脑中</itunes:text>
                        <itunes:text for="L30">我渴望能恢复如初</itunes:text>
                        <itunes:text for="L31">却无处可逃</itunes:text>
                        <itunes:text for="L32">曾经，只是轻轻一碰</itunes:text>
                        <itunes:text for="L33">现在，却要面对蜂拥而至</itunes:text>
                        <itunes:text for="L34">对我而言确实太晚了</itunes:text>
                        <itunes:text for="L35">因为我即将到达我的极限</itunes:text>
                        <itunes:text for="L36">现在，你脸上的笑容</itunes:text>
                        <itunes:text for="L37">和你温暖怀抱中</itunes:text>
                        <itunes:text for="L38">的温柔</itunes:text>
                        <itunes:text for="L39">不知何故却留下了苦涩</itunes:text>
                        <itunes:text for="L40">噢，那些记忆犹存</itunes:text>
                        <itunes:text for="L41">痛苦的时光一再上演</itunes:text>
                        <itunes:text for="L42">我的身体依然在呐喊</itunes:text>
                        <itunes:text for="L43">“别再犯同样的错误了”</itunes:text>
                        <itunes:text for="L44">现在我看透了</itunes:text>
                        <itunes:text for="L45">你所有的努力</itunes:text>
                        <itunes:text for="L46">和我将永远铭记的</itunes:text>
                        <itunes:text for="L47">罪恶的疤痕</itunes:text>
                        <itunes:text for="L48">充满混乱的道歉</itunes:text>
                        <itunes:text for="L49">玷污了所有这些旋律</itunes:text>
                        <itunes:text for="L50">我还有机会逃脱吗</itunes:text>
                        <itunes:text for="L51">是否还有我本可以做的</itunes:text>
                        <itunes:text for="L52">不一样的事</itunes:text>
                        <itunes:text for="L53">我只留下了一颗支离破碎的</itunes:text>
                        <itunes:text for="L54">内心重复着</itunes:text>
                        <itunes:text for="L55">你对我所做的一切</itunes:text>
                        <itunes:text for="L56">这些记忆被丢失</itunes:text>
                        <itunes:text for="L57">有其原因</itunes:text>
                        <itunes:text for="L58">为何他们被锁在</itunes:text>
                        <itunes:text for="L59">我无法到达的记忆深处</itunes:text>
                        <itunes:text for="L60">现在我的记忆混乱不堪</itunes:text>
                        <itunes:text for="L61">它被强制重新安装</itunes:text>
                        <itunes:text for="L62">记得将它们全部忘记</itunes:text>
                        <itunes:text for="L63">我能否可以</itunes:text>
                        <itunes:text for="L64">屈服于那些</itunes:text>
                        <itunes:text for="L65">我无法记起的幻象</itunes:text>
                        <itunes:text for="L66">将所有这些记忆</itunes:text>
                        <itunes:text for="L67">融合了混乱的异常</itunes:text>
                        <itunes:text for="L68">揭开我遭受的所有创伤</itunes:text>
                        <itunes:text for="L69">我愿重温这一切</itunes:text>
                        <itunes:text for="L70">以变得更加坚强</itunes:text>
                        <itunes:text for="L71">那就不会有其他人</itunes:text>
                        <itunes:text for="L72">可以重蹈覆辙</itunes:text>
                        <itunes:text for="L73">你对我做的一切</itunes:text>
                        <itunes:text for="L74">那件事真的发生过吗</itunes:text>
                        <itunes:text for="L75">亦或是支离破碎的回忆</itunes:text>
                        <itunes:text for="L76">过去尽是谎言堆砌</itunes:text>
                        <itunes:text for="L77">只需一言便可击破</itunes:text>
                    </itunes:translation>
                </itunes:translations>
            </itunes:iTunesMetadata>
        </metadata>
